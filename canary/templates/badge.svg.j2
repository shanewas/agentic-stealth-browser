<svg xmlns="http://www.w3.org/2000/svg" width="88" height="20" role="img" aria-label="{{ label }}: {{ message }}">
  <title>{{ label }}: {{ message }}</title>
  <linearGradient id="s" x2="0" y2="100%">
    <stop offset="0" stop-color="#bbb" stop-opacity=".1"/>
    <stop offset="1" stop-opacity=".1"/>
  </linearGradient>
  <clipPath id="r"><rect width="88" height="20" rx="3" fill="#fff"/></clipPath>
  <g clip-path="url(#r)">
    <rect width="42" height="20" fill="#555"/>
    <rect x="42" width="46" height="20" fill="{{ color }}"/>
    <rect width="88" height="20" fill="url(#s)"/>
    <g fill="#fff" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="11">
      <text x="21" y="14">{{ label }}</text>
      <text x="65" y="14">{{ message }}</text>
    </g>
  </g>
</svg>